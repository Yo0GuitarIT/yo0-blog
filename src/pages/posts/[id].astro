---
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const allPosts = await getCollection("posts");
  const sorted = allPosts.sort(
    (a, b) => a.data.date.getTime() - b.data.date.getTime(),
  );
  return sorted.map((post, index) => ({
    params: { id: post.id },
    props: {
      post,
      prevPost: index > 0 ? sorted[index - 1] : null,
      nextPost: index < sorted.length - 1 ? sorted[index + 1] : null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);

const anchorStyle =
  "text-gray-500 dark:text-gray-400 hover:underline dark:hover:underline";
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
>
  <article>
    <header class="mb-8">
      <h1
        class="text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-100"
      >
        {post.data.title}
      </h1>
      <time
        datetime={post.data.date.toISOString()}
        class="mt-2 block text-sm text-gray-500 dark:text-gray-400"
      >
        {post.data.date.toLocaleDateString("zh-TW")}
      </time>
      {
        post.data.description && (
          <p class="mt-2 text-gray-600 italic dark:text-gray-400">
            {post.data.description}
          </p>
        )
      }
    </header>
    <div class="markdown-content">
      <Content />
    </div>
  </article>
  <div class="mt-8 flex justify-between">
    {
      prevPost ? (
        <a href={`/posts/${prevPost.id}`} class={anchorStyle}>
          &larr; {prevPost.data.title}
        </a>
      ) : (
        <span />
      )
    }
    {
      nextPost ? (
        <a href={`/posts/${nextPost.id}`} class={anchorStyle}>
          {nextPost.data.title} &rarr;
        </a>
      ) : (
        <span />
      )
    }
  </div>
</Layout>
