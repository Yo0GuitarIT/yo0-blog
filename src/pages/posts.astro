---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts");
const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Layout>
  <h3 class="text-xl">文章列表</h3>
  <ul class="mt-2 space-y-4">
    {
      sortedPosts.map((post) => (
        <li class="flex flex-col gap-1 text-gray-500 hover:text-gray-800 dark:text-gray-400 dark:hover:text-gray-100">
          <a class="text-lg hover:underline" href={`/posts/${post.id}`}>
            <span>{post.data.title}</span>
          </a>
          <time class="text-sm" datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString("zh-TW")}
          </time>
          {/* <p>{post.data.description}</p> */}
        </li>
      ))
    }
  </ul>
</Layout>
