---
import { Icon } from "astro-icon/components";
const isMenu = Astro.url.pathname === "/menu";
---

<header>
  <div class="flex items-center justify-end gap-2 text-right">
    <a
      href="/rss.xml"
      aria-label="RSS 訂閱"
      class="text-gray-500 hover:text-gray-800 dark:text-gray-400 dark:hover:text-gray-100"
    >
      <Icon name="mdi:rss" class="size-5" />
    </a>
    <button
      id="theme-toggle"
      type="button"
      aria-label="切換主題"
      class="text-gray-500 hover:text-gray-800 dark:text-gray-400 dark:hover:text-gray-100"
    >
      <Icon name="mdi:white-balance-sunny" class="size-5 dark:hidden" />
      <Icon name="mdi:moon-and-stars" class="hidden size-5 dark:block" />
    </button>
    {
      isMenu ? (
        <a
          id="menu-close"
          href="/"
          aria-label="關閉選單"
          class="text-gray-500 hover:text-gray-800 dark:text-gray-400 dark:hover:text-gray-100"
        >
          <Icon name="mdi:close" class="size-5" />
        </a>
      ) : (
        <a
          href="/menu"
          aria-label="選單"
          class="text-gray-500 hover:text-gray-800 dark:text-gray-400 dark:hover:text-gray-100"
        >
          <Icon name="mdi:menu" class="size-5" />
        </a>
      )
    }
  </div>
  <a href="/">
    <h1
      class="flex items-center gap-2 text-xl font-bold tracking-tight text-gray-900 hover:underline dark:text-gray-100"
    >
      Yo0's Blog
    </h1>
  </a>
</header>

<script>
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    document.documentElement.style.colorScheme = isDark ? "dark" : "light";
    localStorage.setItem("theme", isDark ? "dark" : "light");
  });

  // 漸進增強：有同源的上一頁時，關閉選單改為返回上一頁；
  // 否則維持 anchor 的預設行為（導回首頁）。
  document.getElementById("menu-close")?.addEventListener("click", (e) => {
    const ref = document.referrer;
    if (history.length > 1 && ref && new URL(ref).origin === location.origin) {
      e.preventDefault();
      history.back();
    }
  });
</script>
