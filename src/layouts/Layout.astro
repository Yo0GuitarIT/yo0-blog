---
import "@/styles/global.css";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { Font } from "astro:assets";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const SITE_NAME = "Yo0's Blog";
const SITE_DESCRIPTION = "Yo0 的個人部落格。";

const { title, description, image } = Astro.props;

const pathName = Astro.url.pathname.split("/")[1];
// 字首大寫
const tabName = pathName
  ? pathName.charAt(0).toUpperCase() + pathName.slice(1)
  : "";

// 有傳 title 就用「文章標題 - 站名」，否則沿用 pathname 推導
const pageTitle = title
  ? `${title} - ${SITE_NAME}`
  : `${SITE_NAME}${tabName ? ` - ${tabName}` : ""}`;
const pageDescription = description ?? SITE_DESCRIPTION;

// 需要 astro.config.ts 設定 site 才能產生絕對網址
const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
const ogImage =
  image && Astro.site ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {canonicalURL && <link rel="canonical" href={canonicalURL.href} />}

    {/* Open Graph */}
    <meta property="og:type" content={title ? "article" : "website"} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {canonicalURL && <meta property="og:url" content={canonicalURL.href} />}
    {ogImage && <meta property="og:image" content={ogImage} />}

    {/* Twitter Card */}
    <meta
      name="twitter:card"
      content={ogImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    {/* RSS */}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_NAME}
      href="/rss.xml"
    />

    <Font cssVariable="--font-jetbrains-mono" preload />
    <script is:inline>
      const theme =
        localStorage.getItem("theme") ??
        (window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light");
      document.documentElement.classList.toggle("dark", theme === "dark");
      document.documentElement.style.colorScheme = theme;
    </script>
  </head>
  <body class="flex justify-center">
    <div class="w-full max-w-2xl space-y-2 p-4">
      <Header />
      <main class="w-full">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
