---
const ROUTES = [
  { name: "Home", path: "/" },
  { name: "Posts", path: "/posts" },
  { name: "About", path: "/about" },
];
---

<header class="flex items-center justify-between">
  <h1>Yo0's Blog</h1>
  <div class="flex gap-4">
    {ROUTES.map((route) => <a href={route.path}>{route.name}</a>)}
  </div>
</header>
