---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";

const allPosts = await getCollection("posts");
const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const getFallbackImage = (id: string) =>
  `https://picsum.photos/seed/${id}/1200/600`;
---

<Layout>
  <div class="flex items-center justify-between">
    <h3 class="text-xl">文章列表</h3>
    <div
      class="flex items-center gap-1 text-gray-400"
      role="tablist"
      aria-label="文章呈現方式"
    >
      <button
        type="button"
        data-view-toggle="list"
        class="view-toggle rounded p-1.5 transition-colors hover:text-gray-800 dark:hover:text-gray-100"
        aria-label="列表式呈現"
      >
        <Icon name="mdi:format-list-bulleted" class="size-5" />
      </button>
      <button
        type="button"
        data-view-toggle="grid"
        class="view-toggle rounded p-1.5 transition-colors hover:text-gray-800 dark:hover:text-gray-100"
        aria-label="卡片式呈現"
      >
        <Icon name="mdi:view-module" class="size-5" />
      </button>
    </div>
  </div>

  {/* 列表式 */}
  <ul data-view-panel="list" class="mt-4 space-y-4">
    {
      sortedPosts.map((post) => (
        <li class="flex flex-col gap-1 text-gray-500 hover:text-gray-800 dark:text-gray-400 dark:hover:text-gray-100">
          <a class="text-lg hover:underline" href={`/posts/${post.id}`}>
            <span>{post.data.title}</span>
          </a>
          {post.data.description && (
            <p class="text-md text-gray-500 italic dark:text-gray-400">
              {post.data.description}
            </p>
          )}
          <time class="text-sm" datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString("zh-TW")}
          </time>
        </li>
      ))
    }
  </ul>

  {/* 卡片式 */}
  <ul
    data-view-panel="grid"
    class="mt-4 hidden grid-cols-1 gap-4 sm:grid-cols-2"
  >
    {
      sortedPosts.map((post) => (
        <li>
          <a
            href={`/posts/${post.id}`}
            class="group flex h-full flex-col overflow-hidden rounded-lg border border-gray-200 transition-colors hover:border-gray-300 dark:border-gray-700 dark:hover:border-gray-600"
          >
            <img
              src={post.data.image ?? getFallbackImage(post.id)}
              alt={post.data.title}
              loading="lazy"
              class="aspect-3/1 w-full object-cover"
            />
            <div class="flex flex-1 flex-col gap-2 p-4">
              <h4 class="text-lg text-gray-800 group-hover:underline dark:text-gray-100">
                {post.data.title}
              </h4>
              {post.data.description && (
                <p class="text-gray-500 dark:text-gray-400">
                  {post.data.description}
                </p>
              )}
              <time
                class="mt-auto text-sm text-gray-400 dark:text-gray-500"
                datetime={post.data.date.toISOString()}
              >
                {post.data.date.toLocaleDateString("zh-TW")}
              </time>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>

<script>
  const STORAGE_KEY = "posts-view";

  function applyView(view: string) {
    document
      .querySelectorAll<HTMLElement>("[data-view-panel]")
      .forEach((el) => {
        const isActive = el.dataset.viewPanel === view;
        el.classList.toggle("hidden", !isActive);
        // grid panel needs `grid` display when active
        if (el.dataset.viewPanel === "grid") {
          el.classList.toggle("grid", isActive);
        }
      });
    document
      .querySelectorAll<HTMLElement>("[data-view-toggle]")
      .forEach((el) => {
        const isActive = el.dataset.viewToggle === view;
        el.classList.toggle("text-gray-800", isActive);
        el.classList.toggle("dark:text-gray-100", isActive);
        el.setAttribute("aria-selected", String(isActive));
      });
  }

  function initView() {
    const saved = localStorage.getItem(STORAGE_KEY) ?? "list";
    applyView(saved);

    document
      .querySelectorAll<HTMLElement>("[data-view-toggle]")
      .forEach((el) => {
        el.addEventListener("click", () => {
          const view = el.dataset.viewToggle!;
          localStorage.setItem(STORAGE_KEY, view);
          applyView(view);
        });
      });
  }

  initView();
  // Re-init on Astro view transitions if used
  document.addEventListener("astro:page-load", initView);
</script>
