---
const ROUTES = [
  { name: "Home", path: "/" },
  { name: "Posts", path: "/posts" },
  { name: "About", path: "/about" },
];
---

<header class="mb-2 flex items-center justify-between border-b py-2">
  Yo0's Blog
  <div class="flex gap-4">
    {ROUTES.map((route) => <a href={route.path}>{route.name}</a>)}
  </div>
</header>
