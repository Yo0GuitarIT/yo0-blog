---
import Layout from "../layouts/Layout.astro";

const ROUTES = [
  { name: "Home", path: "/" },
  { name: "Posts", path: "/posts" },
  { name: "About", path: "/about" },
];
---

<Layout>
  <ul>
    {
      ROUTES.map((route) => (
        <li>
          <a href={route.path}>{route.name}</a>
        </li>
      ))
    }
  </ul>
</Layout>
